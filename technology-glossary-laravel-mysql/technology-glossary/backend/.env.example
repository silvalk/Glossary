APP_NAME="Technology Glossary - Lar Donato Flores"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Banco de dados: MySQL ----
# Copie este arquivo para ".env" e preencha os valores reais localmente.
# Nunca coloque a senha real neste arquivo de exemplo nem no código-fonte.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=technology_glossary
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
